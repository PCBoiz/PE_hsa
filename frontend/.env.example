# ── Frontend env (Vercel) ── Chỉ biến có tiền tố NEXT_PUBLIC_ mới lộ ra client.
#
# BẮT BUỘC: URL gốc backend (Render). pe-bridge.js rewrite mọi /api/* + /auth/*
# về origin này (đọc ở src/app/layout.tsx). THIẾU biến này → fallback
# http://localhost:9000 → toàn bộ API/login FAIL trên production.
#
# Local dev: để trống (mặc định localhost:9000). Vercel: set trong Project
# Settings → Environment Variables cho cả Production + Preview.
NEXT_PUBLIC_API_URL=https://pe-hsa-backend.onrender.com
