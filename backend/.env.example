# Example environment variables for local development
# Do NOT commit a real .env with secrets
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
FLASK_DEBUG=0
PORT=9000
ALLOWED_ORIGINS=http://localhost:9000

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - Facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Grapuco integration
GRAPUCO_API_KEY=your-grapuco-api-key
GRAPUCO_API_URL=https://api.grapuco.com
GRAPUCO_PROJECT_ID=your-grapuco-project-id

# Chỉ dùng khi dev (HTTP). Xoá trong production
OAUTHLIB_INSECURE_TRANSPORT=1
# Django-specific (bản migrate)
DJANGO_ENV=development
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# Chatbot Trợ lý HSA — DeepSeek. Lấy key tại platform.deepseek.com
# Hai model: lượt chữ đi bản mạnh, lượt có ảnh đi bản đọc được ảnh (v4-pro bỏ qua ảnh).
# Bỏ trống hai dòng model để nhận mặc định trong settings.py. ĐỪNG đặt `deepseek-chat`:
# tên ấy còn được nhận nhưng bị chuyển lặng sang bản flash (đo 20/09/2026).
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_ANH=deepseek-flash
# DEEPSEEK_THINKING=1 bật chế độ nghĩ (chậm ~2×, tốn token; đo 20/09 chưa thấy hơn gì)

# ── Gửi thư (Gmail SMTP) ───────────────────────────────────────────────────
# `common/mail.py` đọc ba biến này. THIẾU `EMAIL_USER` hoặc `EMAIL_APP_PASSWORD`
# thì `mail.py::thieu_cau_hinh()` báo thiếu và KHÔNG gửi gì — tức mọi thư báo
# cáo gửi phụ huynh im lặng không đi. Ba khoá này đã có trong `.env` thật nhưng
# chưa từng được ghi ở đây (phát hiện 22/09/2026).
#
# EMAIL_APP_PASSWORD là "mật khẩu ứng dụng" của Google, KHÔNG phải mật khẩu tài
# khoản: tạo ở Google Account → Security → 2-Step Verification → App passwords.
EMAIL_USER=tai-khoan-gui@gmail.com
EMAIL_APP_PASSWORD=mat-khau-ung-dung-16-ky-tu
# Tên hiện ở ô "From" khi phụ huynh nhận thư. Bỏ trống → mặc định "TopHSA".
EMAIL_TU_TEN=TopHSA

# ── Sau proxy: IP thật và bí mật tin cậy header IP ─────────────────────────
# NUM_PROXIES = số chặng proxy TIN CẬY đứng trước Django. Render có 1 chặng;
# chạy thẳng trên máy thì 0. Nó chọn phần tử thứ n từ cuối `X-Forwarded-For`
# (xem `common/net.py`), nên đặt sai là đọc nhầm IP do khách tự viết.
NUM_PROXIES=1

# PROXY_SHARED_SECRET là một nửa của MỘT CẶP. Nửa kia là `PE_PROXY_SECRET` đặt
# ở Vercel (xem `frontend/.env.example`). HAI BÊN PHẢI CÙNG MỘT GIÁ TRỊ.
#
# Django chỉ tin header `X-PE-Client-IP` khi bí mật khớp — thiếu bước ấy thì ai
# gọi THẲNG Render cũng đặt được header IP, tức mở lại đúng cái lỗ vừa bịt.
#
# ĐỂ TRỐNG thì chạy y như trước, chỉ là giới hạn tốc độ KHÔNG tách được theo IP
# thật: mọi người dùng chung một xô. Mặc định ĐÓNG là cố ý.
# Ngắn hơn 16 ký tự bị coi như chưa có.
# Sinh giá trị:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_SHARED_SECRET=
