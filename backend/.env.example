# Example environment variables for local development
# Do NOT commit a real .env with secrets
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
FLASK_DEBUG=0
PORT=9000
ALLOWED_ORIGINS=http://localhost:9000

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - Facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Grapuco integration
GRAPUCO_API_KEY=your-grapuco-api-key
GRAPUCO_API_URL=https://api.grapuco.com
GRAPUCO_PROJECT_ID=your-grapuco-project-id

# Chỉ dùng khi dev (HTTP). Xoá trong production
OAUTHLIB_INSECURE_TRANSPORT=1
# Django-specific (bản migrate)
DJANGO_ENV=development
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# Chatbot Trợ lý HSA — DeepSeek. Lấy key tại platform.deepseek.com
# Hai model: lượt chữ đi bản mạnh, lượt có ảnh đi bản đọc được ảnh (v4-pro bỏ qua ảnh).
# Bỏ trống hai dòng model để nhận mặc định trong settings.py. ĐỪNG đặt `deepseek-chat`:
# tên ấy còn được nhận nhưng bị chuyển lặng sang bản flash (đo 20/09/2026).
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_ANH=deepseek-flash
# DEEPSEEK_THINKING=1 bật chế độ nghĩ (chậm ~2×, tốn token; đo 20/09 chưa thấy hơn gì)
